# Copia a .env (make up lo hace solo). .env esta ignorado por git.
# Valores SOLO de desarrollo local; nada de esto es secreto real.

# Periodo academico simulado y semilla del generador sintetico (Faker es_CO)
PERIODO=2027-1
SEED=20271

# --- Endpoints vistos desde el host (make seed, pruebas, scripts) ---
# MongoDB 7 (simula Cosmos DB API MongoDB)
MONGO_URL=mongodb://localhost:27017/inscripcion
# Redis 7 (cupos atomicos, bloques ocupados, reservas)
REDIS_URL=redis://localhost:6379/0
# Redpanda, listener externo (simula Event Hubs). Dentro de la red de compose: redpanda:9092
KAFKA_BROKERS=localhost:19092
# MinIO API (simula ADLS Gen2). Consola web en http://localhost:9001
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio-dev
MINIO_SECRET_KEY=minio-dev-secret
MINIO_SECURE=false
# Usuario de servicio de la API: solo lectura sobre el bucket gold
MINIO_API_ACCESS_KEY=api-lector
MINIO_API_SECRET_KEY=api-lector-secret-dev

# --- API y workers (fase 3) ---
# Dentro de docker compose, api/workers reciben los hosts internos por `environment:`
# (mongo:27017, redis:6379, redpanda:9092, minio:9000); estas URLs son para el host.
# >= 32 bytes; la API no arranca sin JWT_SECRET ni DEMO_PASSWORD
JWT_SECRET=dev-solo-local-secreto-de-32-bytes-o-mas-0123456789
JWT_TTL_MIN=60
# Clave del login simulado (Entra ID) para TODOS los estudiantes sinteticos
DEMO_PASSWORD=uniminuto2027
# Duracion de la reserva temporal de cupo, en segundos
RESERVA_TTL_S=300
# Sal para anonimizar estudianteId en plata/oro (SHA-256)
HASH_SALT=dev-sal-local
CORS_ORIGINS=http://localhost:3000
# Tasa de fallo (0.0-1.0) del sistema academico simulado en enroll-worker
FALLO_SISTEMA_ACADEMICO=0.0

# --- Fase 6: data lake ---
# Cada cuantos minutos el lake-worker recalcula plata y oro (la ingesta a bronce es continua)
LAKE_RECALCULO_MIN=5
# Bronce escribe un lote al llegar a N mensajes o tras N segundos
LAKE_LOTE_MAX=500
LAKE_LOTE_MAX_S=3
